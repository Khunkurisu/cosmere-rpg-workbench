<div class="flexcol" style="min-height:500px">
	<nav class="sheet-navigation sheet-tabs tabs" style="margin-top: 0.2rem; gap: 3rem;">
		{{#each tabs as |tab|}}
			<a class="{{tab.cssClass}}" data-tab="{{tab.id}}" data-group="primary" data-action="set-tab">
				{{localize tab.label}}
			</a>
		{{/each}}
	</nav>
	<div class="tab-body">
		<div class="scroll-container">
			<div class="scroll-body tab tab-content">
				<div class="search-bar">
					<div class="icon faded">
						<i class="fa-solid fa-magnifying-glass"></i>
					</div>
					<input type="text" id="compendium-search-{{currentTab}}" placeholder="Search {{localize tabPlural}}"
						value="{{search}}">
				</div>
				<div class="search-bar">
					<label class="label" style="min-width:80px;width:fit-content">{{localize includeLabel}}</label>
					<input class="include-filter" name="include-tags" id="type-exclusion-{{currentTab}}"
						pattern='^[A-Za-z_✲ ]{1,15}$' value="{{excludedTypes}}">
				</div>
				<ul class="item-list" style="min-height:500px">
					<li class="item header">
						<section class="details">
							<span class="title">{{localize tabTitle}}</span>
						</section>
					</li>
					{{#each items}}
						<li class="item" data-item-id="{{this.id}}" data-pack-id="{{this.pack}}" data-drag="true">
							<section class="details">
								{{!-- Image --}}
								<div class="img">
									<img src="{{this.img}}">
								</div>

								{{!-- Name --}}
								<div class="name">
									{{this.name}}
								</div>

								{{!-- Type --}}
								<div class="detail wide type">
									{{this.type}}
								</div>

								<div class="controls icon faded">
									<a role="button" data-action="show-item-sheet"
										data-tooltip="workbench.generic.viewSheet" data-item-id="{{this.id}}"
										data-pack-id="{{this.pack}}">
										<i class="fa-solid fa-magnifying-glass"></i>
									</a>
								</div>
							</section>
						</li>
					{{/each}}
				</ul>
			</div>
		</div>
	</div>
</div>
